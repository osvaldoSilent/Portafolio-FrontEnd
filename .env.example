# ==============================================================================
# PORTFOLIO FRONTEND — VARIABLES DE ENTORNO (PLANTILLA SIN DATOS SENSIBLES)
# Copia este archivo a `.env.local` y reemplaza con tus credenciales reales.
# Nunca subas `.env.local` al repositorio.
# ==============================================================================

# URL de conexión con Connection Pooling (-pooler) para el runtime Serverless HTTP
DATABASE_URL="postgresql://<db_user>:<db_password>@ep-<endpoint_id>-pooler.<region>.aws.neon.tech/<db_name>?sslmode=require"

# URL de conexión directa (sin pooler) exclusiva para migraciones con Drizzle Kit
DIRECT_URL="postgresql://<db_user>:<db_password>@ep-<endpoint_id>.<region>.aws.neon.tech/<db_name>?sslmode=require"

# Código OTP Maestro para desbloquear el Gatekeeper en entorno Demo / Recruiter
GATEKEEPER_MASTER_OTP="replace_with_6_digit_otp"

